<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1.0" />
  <meta name="description" content="Islamic Students Online Test - Test your knowledge of Islam." />
  <title>Islamic Students Online Test</title>

  <style>
    :root {
      --green-dark: #075e46;
      --green: #0b8062;
      --green-light: #e9f7f1;
      --gold: #d5a62a;
      --gold-light: #fff8df;
      --white: #ffffff;
      --text: #1e2d28;
      --muted: #6d7d77;
      --danger: #bd3030;
      --danger-light: #fff0f0;
      --success: #197647;
      --success-light: #eaf8ef;
      --border: #dce9e3;
      --shadow: 0 12px 35px rgba(3, 66, 48, 0.1);
      --radius: 18px;
    }

    * {
      box-sizing: border-box;
    }

    html {
      scroll-behavior: smooth;
    }

    body {
      margin: 0;
      min-height: 100vh;
      color: var(--text);
      background:
        radial-gradient(circle at top right, rgba(213, 166, 42, 0.12), transparent 30%),
        linear-gradient(135deg, #f5fbf8 0%, #ffffff 50%, #f1faf6 100%);
      font-family: "Segoe UI", Tahoma, Geneva, Verdana, sans-serif;
    }

    button,
    input {
      font: inherit;
    }

    button {
      cursor: pointer;
    }

    .site-header {
      position: relative;
      overflow: hidden;
      color: var(--white);
      background:
        linear-gradient(135deg, rgba(3, 66, 48, 0.97), rgba(11, 128, 98, 0.94)),
        var(--green-dark);
    }

    .site-header::after {
      position: absolute;
      right: 7%;
      bottom: -55px;
      width: 180px;
      height: 180px;
      border: 1px solid rgba(255, 255, 255, 0.15);
      border-radius: 50%;
      box-shadow:
        0 0 0 20px rgba(255, 255, 255, 0.04),
        0 0 0 40px rgba(255, 255, 255, 0.04);
      content: "";
    }

    .header-content {
      position: relative;
      z-index: 1;
      display: flex;
      align-items: center;
      justify-content: space-between;
      width: min(1120px, calc(100% - 32px));
      min-height: 92px;
      margin: auto;
      gap: 20px;
    }

    .brand {
      display: flex;
      align-items: center;
      gap: 13px;
    }

    .brand-icon {
      display: grid;
      width: 48px;
      height: 48px;
      place-items: center;
      color: var(--gold);
      border: 1px solid rgba(255, 255, 255, 0.35);
      border-radius: 14px;
      background: rgba(255, 255, 255, 0.1);
      font-size: 1.65rem;
    }

    .brand h1 {
      margin: 0;
      font-size: clamp(1.05rem, 2vw, 1.45rem);
      letter-spacing: 0.2px;
    }

    .brand p {
      margin: 4px 0 0;
      color: rgba(255, 255, 255, 0.78);
      font-size: 0.82rem;
    }

    .header-arabic {
      color: rgba(255, 255, 255, 0.88);
      font-size: clamp(1.1rem, 2.5vw, 1.65rem);
      direction: rtl;
    }

    main {
      width: min(920px, calc(100% - 32px));
      min-height: calc(100vh - 170px);
      margin: 0 auto;
      padding: 48px 0 64px;
    }

    .screen {
      display: none;
      animation: fadeIn 0.35s ease;
    }

    .screen.active {
      display: block;
    }

    @keyframes fadeIn {
      from {
        opacity: 0;
        transform: translateY(8px);
      }
      to {
        opacity: 1;
        transform: translateY(0);
      }
    }

    .welcome-card,
    .test-card,
    .result-card {
      border: 1px solid var(--border);
      border-radius: var(--radius);
      background: rgba(255, 255, 255, 0.94);
      box-shadow: var(--shadow);
    }

    .welcome-card {
      max-width: 650px;
      margin: 28px auto;
      padding: clamp(28px, 6vw, 58px);
      text-align: center;
    }

    .crescent {
      display: inline-grid;
      width: 78px;
      height: 78px;
      margin-bottom: 20px;
      place-items: center;
      color: var(--gold);
      border: 2px solid rgba(213, 166, 42, 0.35);
      border-radius: 50%;
      background: var(--gold-light);
      font-size: 2.8rem;
    }

    h2,
    h3 {
      color: var(--green-dark);
    }

    .welcome-card h2 {
      margin: 0;
      font-size: clamp(1.8rem, 4vw, 2.65rem);
    }

    .welcome-card .lead {
      margin: 14px 0 30px;
      color: var(--muted);
      font-size: 1.05rem;
    }

    .form-group {
      max-width: 450px;
      margin: 0 auto;
      text-align: left;
    }

    label {
      display: block;
      margin-bottom: 8px;
      color: var(--green-dark);
      font-weight: 700;
    }

    input[type="text"] {
      width: 100%;
      padding: 15px 16px;
      color: var(--text);
      border: 2px solid var(--border);
      border-radius: 12px;
      outline: none;
      background: var(--white);
      transition: border-color 0.2s, box-shadow 0.2s;
    }

    input[type="text"]:focus {
      border-color: var(--green);
      box-shadow: 0 0 0 4px rgba(11, 128, 98, 0.12);
    }

    .error-message {
      display: none;
      margin-top: 9px;
      color: var(--danger);
      font-size: 0.9rem;
    }

    .error-message.visible {
      display: block;
    }

    .primary-button,
    .secondary-button,
    .option-button {
      border: 0;
      transition: transform 0.2s, background 0.2s, border-color 0.2s;
    }

    .primary-button,
    .secondary-button {
      min-height: 48px;
      padding: 13px 24px;
      border-radius: 12px;
      font-weight: 700;
    }

    .primary-button {
      color: var(--white);
      background: var(--green);
      box-shadow: 0 6px 16px rgba(11, 128, 98, 0.22);
    }

    .primary-button:hover {
      background: var(--green-dark);
      transform: translateY(-2px);
    }

    .secondary-button {
      color: var(--green-dark);
      border: 1px solid var(--border);
      background: var(--white);
    }

    .secondary-button:hover {
      border-color: var(--green);
      background: var(--green-light);
    }

    .start-button {
      width: 100%;
      margin-top: 22px;
    }

    .test-card {
      padding: clamp(20px, 4vw, 36px);
    }

    .test-topbar {
      display: flex;
      align-items: center;
      justify-content: space-between;
      gap: 14px;
      margin-bottom: 20px;
    }

    .student-badge {
      max-width: 45%;
      overflow: hidden;
      color: var(--green-dark);
      font-size: 0.95rem;
      font-weight: 700;
      text-overflow: ellipsis;
      white-space: nowrap;
    }

    .progress-text {
      color: var(--muted);
      font-size: 0.94rem;
      font-weight: 700;
    }

    .progress-track {
      width: 100%;
      height: 9px;
      margin-bottom: 30px;
      overflow: hidden;
      border-radius: 99px;
      background: #e5eee9;
    }

    .progress-bar {
      height: 100%;
      border-radius: inherit;
      background: linear-gradient(90deg, var(--green), var(--gold));
      transition: width 0.3s ease;
    }

    .question-number {
      margin: 0 0 10px;
      color: var(--gold);
      font-size: 0.92rem;
      font-weight: 800;
      letter-spacing: 0.07em;
      text-transform: uppercase;
    }

    .question-text {
      margin: 0 0 25px;
      color: var(--green-dark);
      font-size: clamp(1.3rem, 3vw, 1.7rem);
      line-height: 1.4;
    }

    .options {
      display: grid;
      gap: 13px;
    }

    .option-button {
      display: flex;
      align-items: center;
      width: 100%;
      min-height: 60px;
      padding: 12px 16px;
      color: var(--text);
      border: 2px solid var(--border);
      border-radius: 13px;
      background: var(--white);
      text-align: left;
    }

    .option-button:hover {
      border-color: var(--green);
      background: var(--green-light);
    }

    .option-button.selected {
      color: var(--green-dark);
      border-color: var(--green);
      background: var(--green-light);
      box-shadow: 0 0 0 3px rgba(11, 128, 98, 0.1);
    }

    .option-letter {
      display: grid;
      flex: 0 0 34px;
      width: 34px;
      height: 34px;
      margin-right: 13px;
      place-items: center;
      color: var(--green-dark);
      border-radius: 50%;
      background: #edf5f1;
      font-weight: 800;
    }

    .selected .option-letter {
      color: var(--white);
      background: var(--green);
    }

    .navigation {
      display: flex;
      justify-content: space-between;
      gap: 14px;
      margin-top: 30px;
      padding-top: 23px;
      border-top: 1px solid var(--border);
    }

    .submit-button {
      background: var(--gold);
      color: #332700;
      box-shadow: 0 6px 16px rgba(213, 166, 42, 0.22);
    }

    .submit-button:hover {
      background: #bd8e15;
    }

    .validation-message {
      display: none;
      margin-top: 20px;
      padding: 13px 15px;
      color: var(--danger);
      border: 1px solid #f1c5c5;
      border-radius: 10px;
      background: var(--danger-light);
      line-height: 1.5;
    }

    .validation-message.visible {
      display: block;
    }

    .result-card {
      padding: clamp(22px, 5vw, 42px);
    }

    .result-heading {
      margin: 0;
      color: var(--green-dark);
      text-align: center;
      font-size: clamp(1.8rem, 4vw, 2.5rem);
    }

    .result-subtitle {
      margin: 8px 0 26px;
      color: var(--muted);
      text-align: center;
    }

    .score-panel {
      display: grid;
      grid-template-columns: 1.3fr 1fr 1fr;
      gap: 14px;
      margin-bottom: 26px;
    }

    .score-box {
      padding: 20px 12px;
      border: 1px solid var(--border);
      border-radius: 14px;
      background: var(--green-light);
      text-align: center;
    }

    .score-box.highlight {
      color: var(--white);
      border-color: var(--green);
      background: var(--green);
    }

    .score-box strong {
      display: block;
      font-size: clamp(1.6rem, 4vw, 2.3rem);
    }

    .score-box span {
      display: block;
      margin-top: 5px;
      font-size: 0.83rem;
      font-weight: 700;
    }

    .performance-message {
      margin: 20px 0 30px;
      padding: 15px;
      color: var(--green-dark);
      border-left: 4px solid var(--gold);
      border-radius: 8px;
      background: var(--gold-light);
      line-height: 1.5;
      text-align: center;
    }

    .details-heading {
      margin: 0 0 15px;
      color: var(--green-dark);
      font-size: 1.3rem;
    }

    .details-list {
      display: grid;
      gap: 13px;
    }

    .detail-item {
      padding: 16px;
      border: 1px solid var(--border);
      border-left: 5px solid var(--success);
      border-radius: 11px;
      background: #fbfefd;
    }

    .detail-item.wrong {
      border-left-color: var(--danger);
      background: #fffafa;
    }

    .detail-question {
      margin: 0 0 10px;
      font-weight: 700;
      line-height: 1.45;
    }

    .answer-line {
      margin: 5px 0 0;
      color: var(--muted);
      font-size: 0.94rem;
    }

    .answer-line strong {
      color: var(--text);
    }

    .status {
      display: inline-block;
      margin-top: 10px;
      padding: 4px 9px;
      border-radius: 99px;
      color: var(--success);
      background: var(--success-light);
      font-size: 0.78rem;
      font-weight: 800;
      text-transform: uppercase;
    }

    .wrong .status {
      color: var(--danger);
      background: var(--danger-light);
    }

    .retake-button {
      display: block;
      margin: 30px auto 0;
    }

    .site-footer {
      padding: 22px 16px;
      color: rgba(255, 255, 255, 0.78);
      background: var(--green-dark);
      text-align: center;
      font-size: 0.9rem;
    }

    @media (max-width: 640px) {
      main {
        width: min(100% - 20px, 920px);
        padding-top: 24px;
      }

      .header-content {
        width: calc(100% - 22px);
        min-height: 78px;
      }

      .header-arabic {
        display: none;
      }

      .brand-icon {
        width: 42px;
        height: 42px;
      }

      .brand p {
        display: none;
      }

      .welcome-card {
        margin: 10px auto;
        padding: 30px 20px;
      }

      .test-card,
      .result-card {
        padding: 20px 15px;
      }

      .score-panel {
        grid-template-columns: 1fr 1fr;
      }

      .score-box:first-child {
        grid-column: 1 / -1;
      }

      .navigation {
        flex-wrap: wrap;
      }

      .navigation button {
        flex: 1 1 140px;
      }

      .option-button {
        min-height: 64px;
      }
    }
  </style>
</head>

<body>
  <header class="site-header">
    <div class="header-content">
      <div class="brand">
        <div class="brand-icon" aria-hidden="true">☪</div>
        <div>
          <h1>Islamic Students Online Test</h1>
          <p>Learn, reflect, and grow in knowledge</p>
        </div>
      </div>
      <div class="header-arabic" aria-hidden="true">بِسْمِ اللَّهِ</div>
    </div>
  </header>

  <main>
    <!-- Home Screen -->
    <section id="homeScreen" class="screen active" aria-labelledby="welcomeTitle">
      <div class="welcome-card">
        <div class="crescent" aria-hidden="true">☪</div>
        <h2 id="welcomeTitle">Test Your Knowledge of Islam</h2>
        <p class="lead">
          Answer 15 questions covering essential Islamic knowledge.
          Take your time and do your best.
        </p>

        <form id="startForm" novalidate>
          <div class="form-group">
            <label for="studentName">Full Name</label>
            <input
              id="studentName"
              name="studentName"
              type="text"
              placeholder="Enter your full name"
              autocomplete="name"
              maxlength="80"
              required
            />
            <div id="nameError" class="error-message" role="alert">
              Please enter your name before starting the test.
            </div>
            <button class="primary-button start-button" type="submit">
              Start Test
            </button>
          </div>
        </form>
      </div>
    </section>

    <!-- Test Screen -->
    <section id="testScreen" class="screen" aria-labelledby="questionText">
      <div class="test-card">
        <div class="test-topbar">
          <div id="studentBadge" class="student-badge"></div>
          <div id="progressText" class="progress-text">Question 1 of 15</div>
        </div>

        <div class="progress-track" aria-label="Test progress">
          <div id="progressBar" class="progress-bar" style="width: 6.67%;"></div>
        </div>

        <p id="questionNumber" class="question-number">Question 1</p>
        <h2 id="questionText" class="question-text"></h2>

        <div id="optionsContainer" class="options" role="radiogroup"></div>

        <div class="navigation">
          <button id="previousButton" class="secondary-button" type="button">
            ← Previous
          </button>
          <button id="nextButton" class="primary-button" type="button">
            Next →
          </button>
          <button id="submitButton" class="primary-button submit-button" type="button">
            Submit Test
          </button>
        </div>

        <div id="validationMessage" class="validation-message" role="alert"></div>
      </div>
    </section>

    <!-- Result Screen -->
    <section id="resultScreen" class="screen" aria-labelledby="resultHeading">
      <div class="result-card">
        <h2 id="resultHeading" class="result-heading">Test Complete</h2>
        <p id="resultSubtitle" class="result-subtitle"></p>

        <div class="score-panel">
          <div class="score-box highlight">
            <strong id="scoreValue">0 / 15</strong>
            <span>Final Score</span>
          </div>
          <div class="score-box">
            <strong id="percentageValue">0%</strong>
            <span>Percentage</span>
          </div>
          <div class="score-box">
            <strong id="gradeValue">F</strong>
            <span>Grade</span>
          </div>
        </div>

        <div id="performanceMessage" class="performance-message"></div>

        <h3 class="details-heading">Answer Details</h3>
        <div id="detailsList" class="details-list"></div>

        <button id="retakeButton" class="primary-button retake-button" type="button">
          Take Test Again
        </button>
      </div>
    </section>
  </main>

  <footer class="site-footer">
    Islamic Students Online Test
  </footer>

  <script>
    /*
      Administrator note:
      Edit the questions below. Each correctAnswer value is the zero-based
      option index:
      0 = A, 1 = B, 2 = C, 3 = D
    */
    const questions = [
      {
        question: "How many pillars are there in Islam?",
        options: ["Three", "Four", "Five", "Six"],
        correctAnswer: 2
      },
      {
        question: "How many articles of faith are there in Islam?",
        options: ["Four", "Five", "Six", "Seven"],
        correctAnswer: 2
      },
      {
        question: "How many obligatory prayers are Muslims required to perform each day?",
        options: ["Three", "Four", "Five", "Six"],
        correctAnswer: 2
      },
      {
        question: "In which month do Muslims fast from dawn until sunset?",
        options: ["Muharram", "Ramadan", "Shawwal", "Rajab"],
        correctAnswer: 1
      },
      {
        question: "What is Zakat?",
        options: [
          "A pilgrimage to Makkah",
          "A compulsory charity given by eligible Muslims",
          "The Friday prayer",
          "A special night prayer"
        ],
        correctAnswer: 1
      },
      {
        question: "What is the name of the pilgrimage to Makkah?",
        options: ["Hajj", "Salah", "Umrah", "Hijrah"],
        correctAnswer: 0
      },
      {
        question: "What is the holy book of Islam?",
        options: ["The Torah", "The Bible", "The Qur'an", "The Psalms"],
        correctAnswer: 2
      },
      {
        question: "Who was the final Prophet of Islam?",
        options: [
          "Prophet Musa (Moses)",
          "Prophet Isa (Jesus)",
          "Prophet Ibrahim (Abraham)",
          "Prophet Muhammad ﷺ"
        ],
        correctAnswer: 3
      },
      {
        question: "Which angel brought revelation from Allah to the Prophets?",
        options: ["Jibril (Gabriel)", "Mikail (Michael)", "Israfil", "Malik"],
        correctAnswer: 0
      },
      {
        question: "What should a Muslim say before beginning a good action?",
        options: ["Alhamdulillah", "Bismillah", "Allahu Akbar", "Astaghfirullah"],
        correctAnswer: 1
      },
      {
        question: "What is the direction Muslims face during Salah called?",
        options: ["Mihrab", "Qiblah", "Minbar", "Madinah"],
        correctAnswer: 1
      },
      {
        question: "Where was Prophet Muhammad ﷺ born?",
        options: ["Madinah", "Jerusalem", "Makkah", "Ta'if"],
        correctAnswer: 2
      },
      {
        question: "What was the migration of Prophet Muhammad ﷺ from Makkah to Madinah called?",
        options: ["Hijrah", "Hajj", "Dawah", "Jihad"],
        correctAnswer: 0
      },
      {
        question: "Which greeting is commonly used by Muslims?",
        options: [
          "Good morning",
          "Peace be upon you",
          "Welcome home",
          "Thank you"
        ],
        correctAnswer: 1
      },
      {
        question: "What should a Muslim do after receiving a blessing from Allah?",
        options: [
          "Say Alhamdulillah",
          "Stay silent",
          "Become proud",
          "Ignore it"
        ],
        correctAnswer: 0
      }
    ];

    const totalQuestions = questions.length;
    const letters = ["A", "B", "C", "D"];

    let currentQuestion = 0;
    let studentName = "";
    let answers = Array(totalQuestions).fill(null);

    const homeScreen = document.getElementById("homeScreen");
    const testScreen = document.getElementById("testScreen");
    const resultScreen = document.getElementById("resultScreen");

    const startForm = document.getElementById("startForm");
    const studentNameInput = document.getElementById("studentName");
    const nameError = document.getElementById("nameError");

    const studentBadge = document.getElementById("studentBadge");
    const progressText = document.getElementById("progressText");
    const progressBar = document.getElementById("progressBar");
    const questionNumber = document.getElementById("questionNumber");
    const questionText = document.getElementById("questionText");
    const optionsContainer = document.getElementById("optionsContainer");
    const previousButton = document.getElementById("previousButton");
    const nextButton = document.getElementById("nextButton");
    const submitButton = document.getElementById("submitButton");
    const validationMessage = document.getElementById("validationMessage");

    const resultSubtitle = document.getElementById("resultSubtitle");
    const scoreValue = document.getElementById("scoreValue");
    const percentageValue = document.getElementById("percentageValue");
    const gradeValue = document.getElementById("gradeValue");
    const performanceMessage = document.getElementById("performanceMessage");
    const detailsList = document.getElementById("detailsList");
    const retakeButton = document.getElementById("retakeButton");

    function showScreen(screenToShow) {
      [homeScreen, testScreen, resultScreen].forEach((screen) => {
        screen.classList.remove("active");
      });

      screenToShow.classList.add("active");
      window.scrollTo({ top: 0, behavior: "smooth" });
    }

    function renderQuestion() {
      const question = questions[currentQuestion];
      const selectedAnswer = answers[currentQuestion];

      progressText.textContent = `Question ${currentQuestion + 1} of ${totalQuestions}`;
      progressBar.style.width = `${((currentQuestion + 1) / totalQuestions) * 100}%`;
      questionNumber.textContent = `Question ${currentQuestion + 1}`;
      questionText.textContent = question.question;

      optionsContainer.innerHTML = "";

      question.options.forEach((option, index) => {
        const optionButton = document.createElement("button");
        optionButton.type = "button";
        optionButton.className = "option-button";
        optionButton.setAttribute("role", "radio");
        optionButton.setAttribute("aria-checked", String(selectedAnswer === index));

        if (selectedAnswer === index) {
          optionButton.classList.add("selected");
        }

        const letter = document.createElement("span");
        letter.className = "option-letter";
        letter.textContent = letters[index];

        const optionText = document.createElement("span");
        optionText.textContent = option;

        optionButton.appendChild(letter);
        optionButton.appendChild(optionText);

        optionButton.addEventListener("click", () => {
          answers[currentQuestion] = index;
          renderQuestion();
          validationMessage.classList.remove("visible");
        });

        optionsContainer.appendChild(optionButton);
      });

      previousButton.disabled = currentQuestion === 0;
      previousButton.style.opacity = currentQuestion === 0 ? "0.55" : "1";

      const isFinalQuestion = currentQuestion === totalQuestions - 1;
      nextButton.style.display = isFinalQuestion ? "none" : "block";
      submitButton.style.display = isFinalQuestion ? "block" : "none";
    }

    function getUnansweredQuestions() {
      return answers
        .map((answer, index) => (answer === null ? index + 1 : null))
        .filter((number) => number !== null);
    }

    function showValidationMessage(unansweredQuestions) {
      const questionList = unansweredQuestions.join(", ");
      validationMessage.textContent =
        `Please answer all questions before submitting. ` +
        `Unanswered question${unansweredQuestions.length > 1 ? "s are" : " is"}: ${questionList}.`;
      validationMessage.classList.add("visible");
      validationMessage.focus();
    }

    function getGrade(percentage) {
      if (percentage >= 90) return "A+";
      if (percentage >= 80) return "A";
      if (percentage >= 70) return "B";
      if (percentage >= 60) return "C";
      if (percentage >= 50) return "D";
      return "F";
    }

    function getPerformanceMessage(percentage) {
      if (percentage >= 90) {
        return "Excellent work! You have demonstrated a very strong understanding of basic Islamic studies.";
      }

      if (percentage >= 80) {
        return "Very good effort! You have shown a strong understanding of the topics covered.";
      }

      if (percentage >= 70) {
        return "Good work! Continue reviewing your Islamic studies to strengthen your knowledge.";
      }

      if (percentage >= 50) {
        return "You are making progress. Review the questions carefully and keep learning.";
      }

      return "Keep studying and try again. Every test is an opportunity to learn and improve.";
    }

    function submitTest() {
      const unansweredQuestions = getUnansweredQuestions();

      if (unansweredQuestions.length > 0) {
        showValidationMessage(unansweredQuestions);
        return;
      }

      const confirmed = window.confirm(
        "Are you sure you want to submit your test? You will not be able to change your answers afterward."
      );

      if (!confirmed) {
        return;
      }

      let correctCount = 0;

      answers.forEach((answer, index) => {
        if (answer === questions[index].correctAnswer) {
          correctCount++;
        }
      });

      const wrongCount = totalQuestions - correctCount;
      const percentage = Math.round((correctCount / totalQuestions) * 100);
      const grade = getGrade(percentage);

      scoreValue.textContent = `${correctCount} / ${totalQuestions}`;
      percentageValue.textContent = `${percentage}%`;
      gradeValue.textContent = grade;
      resultSubtitle.textContent = `${studentName} — here is your test result.`;
      performanceMessage.textContent = getPerformanceMessage(percentage);

      detailsList.innerHTML = "";

      questions.forEach((question, index) => {
        const studentAnswer = answers[index];
        const correctAnswer = question.correctAnswer;
        const isCorrect = studentAnswer === correctAnswer;

        const detailItem = document.createElement("article");
        detailItem.className = `detail-item${isCorrect ? "" : " wrong"}`;

        const detailQuestion = document.createElement("p");
        detailQuestion.className = "detail-question";
        detailQuestion.textContent = `${index + 1}. ${question.question}`;

        const studentAnswerLine = document.createElement("p");
        studentAnswerLine.className = "answer-line";
        studentAnswerLine.innerHTML = `Your answer: <strong>${letters[studentAnswer]}. ${question.options[studentAnswer]}</strong>`;

        const correctAnswerLine = document.createElement("p");
        correctAnswerLine.className = "answer-line";
        correctAnswerLine.innerHTML = `Correct answer: <strong>${letters[correctAnswer]}. ${question.options[correctAnswer]}</strong>`;

        const status = document.createElement("span");
        status.className = "status";
        status.textContent = isCorrect ? "Correct" : "Wrong";

        detailItem.appendChild(detailQuestion);
        detailItem.appendChild(studentAnswerLine);
        detailItem.appendChild(correctAnswerLine);
        detailItem.appendChild(status);
        detailsList.appendChild(detailItem);
      });

      showScreen(resultScreen);
    }

    startForm.addEventListener("submit", (event) => {
      event.preventDefault();

      const enteredName = studentNameInput.value.trim();

      if (!enteredName) {
        nameError.classList.add("visible");
        studentNameInput.focus();
        return;
      }

      nameError.classList.remove("visible");
      studentName = enteredName;
      currentQuestion = 0;
      answers = Array(totalQuestions).fill(null);
      studentBadge.textContent = `Student: ${studentName}`;
      validationMessage.classList.remove("visible");

      renderQuestion();
      showScreen(testScreen);
    });

    studentNameInput.addEventListener("input", () => {
      if (studentNameInput.value.trim()) {
        nameError.classList.remove("visible");
      }
    });

    previousButton.addEventListener("click", () => {
      if (currentQuestion > 0) {
        currentQuestion--;
        validationMessage.classList.remove("visible");
        renderQuestion();
      }
    });

    nextButton.addEventListener("click", () => {
      if (currentQuestion < totalQuestions - 1) {
        currentQuestion++;
        validationMessage.classList.remove("visible");
        renderQuestion();
      }
    });

    submitButton.addEventListener("click", submitTest);

    retakeButton.addEventListener("click", () => {
      studentName = "";
      currentQuestion = 0;
      answers = Array(totalQuestions).fill(null);
      studentNameInput.value = "";
      validationMessage.classList.remove("visible");
      showScreen(homeScreen);
      studentNameInput.focus();
    });
  </script>
</body>
</html>
